// estado: ""
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.forcePasswordChange != true
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role in ['admin', 'editor'];
    }

    function isAdmin() {
      return isStaff()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    match /usuarios/{uid} {
      allow get: if isAdmin() || (isStaff() && request.auth.uid == uid);
      allow list: if isAdmin();
      // Firebase Admin SDK is the sole writer. Client users cannot grant roles.
      allow create, update, delete: if false;
    }

    match /b2b_leads/{leadId} {
      // La captación pública se habilitará mediante un endpoint protegido
      // después de aprobar privacidad, validación y controles de abuso.
      allow create: if false;
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['Pendiente', 'Contactado', 'Aprobado', 'Descartado', 'Aplica', 'No Aplica'];
      allow delete: if false;
    }

    match /distributors/{distributorId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() && (
        !('published' in request.resource.data) || request.resource.data.published != true || (
          request.resource.data.isAuthorized == true
          && request.resource.data.name is string && request.resource.data.name.size() >= 2
          && request.resource.data.city is string && request.resource.data.city.size() >= 2
          && request.resource.data.address is string && request.resource.data.address.size() >= 5
          && request.resource.data.phone is string && request.resource.data.phone.size() >= 7
          && request.resource.data.schedule is string && request.resource.data.schedule.size() >= 3
          && request.resource.data.approvalSource is string && request.resource.data.approvalSource.size() >= 5
          && request.resource.data.reviewedBy is string && request.resource.data.reviewedBy.size() >= 2
          && request.resource.data.latitude is number && request.resource.data.latitude >= -5 && request.resource.data.latitude <= 2
          && request.resource.data.longitude is number && request.resource.data.longitude >= -92 && request.resource.data.longitude <= -75
        )
      );
      allow delete: if isAdmin();
    }

    match /site_content/{sectionId} {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['content', 'updatedAt', 'updatedBy'])
        && request.resource.data.content is map;
      allow delete: if isAdmin();
    }

    match /catalog/{itemId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() && (
        !('published' in request.resource.data) || request.resource.data.published != true || (
          request.resource.data.brand is string && request.resource.data.brand.size() >= 2
          && request.resource.data.model is string && request.resource.data.model.size() >= 2
          && request.resource.data.engine is string && request.resource.data.engine.size() >= 1
          && request.resource.data.year is number && request.resource.data.year >= 1950 && request.resource.data.year <= 2100
          && request.resource.data.sourceReference is string && request.resource.data.sourceReference.size() >= 5
          && request.resource.data.reviewedBy is string && request.resource.data.reviewedBy.size() >= 2
          && request.resource.data.recommendedBattery is map
          && request.resource.data.recommendedBattery.model is string && request.resource.data.recommendedBattery.model.size() >= 2
          && request.resource.data.recommendedBattery.bciGroup is string && request.resource.data.recommendedBattery.bciGroup.size() >= 1
          && request.resource.data.recommendedBattery.dimensions is string && request.resource.data.recommendedBattery.dimensions.size() >= 3
          && request.resource.data.recommendedBattery.polarity is string && request.resource.data.recommendedBattery.polarity.size() >= 3
          && request.resource.data.recommendedBattery.cca is number && request.resource.data.recommendedBattery.cca > 0
          && request.resource.data.recommendedBattery.ah is number && request.resource.data.recommendedBattery.ah > 0
        )
      );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
