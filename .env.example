# ═══════════════════════════════════════════════════════════════
# Baterías Maresa — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your real values.
# NEXT_PUBLIC_ prefix = exposed to the browser (client-side).
# Without prefix = server-only (API routes, Server Components).

# ─── Firebase (Client-Side) ───────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="maresa-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="maresa-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="maresa-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# ─── Supabase (Client-Side) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ─── Server-Only Secrets ─────────────────────────────────────
GEMINI_API_KEY=""
