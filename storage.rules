// estado: ""
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.forcePasswordChange != true
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.role in ['admin', 'editor'];
    }

    match /site-images/{imageId} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
      allow update: if false;
      allow delete: if isStaff()
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
